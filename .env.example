# ---------------------------------------------------------------------------
# Civora — example environment.
#
# Copy to .env.local and fill in only what you need:
#
#     cp .env.example .env.local
#
# Every value below is OPTIONAL. With an empty .env.local the platform runs end
# to end on in-memory and fixture adapters with no cloud credentials at all.
# That is a hard architectural requirement, not a convenience.
#
# The provider switches make the boundary explicit: select a cloud-backed
# provider and its credentials become REQUIRED, and startup fails loudly naming
# the missing variable rather than degrading silently.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Civora

# --- Adapter selection -----------------------------------------------------
# in-memory | firestore
CIVORA_DATA_PROVIDER=in-memory
# fixture | firebase
CIVORA_AUTH_PROVIDER=fixture
# fixture | gemini
CIVORA_REASONING_PROVIDER=fixture

# --- Firebase --------------------------------------------------------------
# Required only when a firestore or firebase adapter is selected.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=civora-local
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emulator hosts. Set by default so local development never reaches the
# network; unset both to talk to a real Firebase project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Google AI -------------------------------------------------------------
# Required only when CIVORA_REASONING_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Google Maps -----------------------------------------------------------
# Optional. Left empty, the platform falls back to the non-Maps renderer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
