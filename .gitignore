# --- Dependencies -------------------------------------------------------------
node_modules/
.pnpm-store/

# --- Build output -------------------------------------------------------------
.next/
out/
dist/
build/
*.tsbuildinfo
# Generated by the framework, and it imports types that only exist after a
# build. Committing it would make a clean-clone type check depend on build order.
next-env.d.ts

# --- Test and coverage output -------------------------------------------------
coverage/
playwright-report/
blob-report/
test-results/
.probe-*/

# --- Environment --------------------------------------------------------------
# Real credentials are never committed. .env.example ships placeholders only.
.env
.env.*
!.env.example

# --- Firebase / emulator state ------------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
emulator-data/
.runtimeconfig.json

# --- Logs ---------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*

# --- Editors and OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Tool caches --------------------------------------------------------------
.turbo/
.vercel/
.cache/

# --- Planning workspace -------------------------------------------------------
# The planning context tree is not a deliverable and must never be published.
Workspace/
