rules_version = '2';

// Deny by default.
//
// Every rule this project adds is written against the tenancy model — a state
// officer reads one state, a district officer one district — and each addition
// ships with a test that proves it both allows the intended access and refuses
// the neighbouring case. Until a collection has such a rule, it stays closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
