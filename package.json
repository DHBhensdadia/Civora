{
  "name": "civora",
  "version": "0.1.0",
  "private": true,
  "description": "Federated AI platform for national-scale health resource and supply chain management across India's primary health centre network.",
  "license": "Apache-2.0",
  "author": "Devansh <dhbhensdadia@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "build": "pnpm --filter @civora/web run build",
    "start": "node scripts/serve-standalone.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:seed": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/seed.ts",
    "forecast:backtest": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/backtest.ts",
    "worker:score": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/score.ts",
    "worker:advisories": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/advisories.ts",
    "worker:propose": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/propose.ts",
    "fl:run": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/fl-run.ts",
    "fl:sweep": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/fl-sweep.ts",
    "ai:eval": "node --import ./scripts/node/register-typescript.mjs apps/worker/src/eval.ts",
    "samples:register": "node --import ./scripts/node/register-typescript.mjs scripts/make-sample-register.mjs",
    "samples:voice": "bash scripts/make-sample-voice.sh",
    "emulators": "firebase emulators:start --config infra/firebase.json --project civora-local",
    "audit": "pnpm audit --audit-level high",
    "check:bundle": "node scripts/check-browser-bundle.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle",
    "test:rules": "firebase emulators:exec --only firestore --project demo-civora --config infra/firebase.json 'vitest run --config vitest.rules.config.ts'"
  },
  "devDependencies": {
    "@civora/config": "workspace:*",
    "@firebase/rules-unit-testing": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "firebase": "catalog:",
    "firebase-tools": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
